# Copy this file to .env and point these at your local trained weights.
# .env itself is gitignored — paths are machine-specific, never commit it.

PLAYER_WEIGHT_PATH="models/player_detector.pt"
COURT_WEIGHT_PATH="models/court_keypoint_detector.pt"

# "pt" (default) or "onnx" — see scripts/export_onnx.py. Falls back to .pt
# automatically if the matching .onnx export doesn't exist yet.
MODEL_FORMAT="pt"
